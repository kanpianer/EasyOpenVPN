#!/usr/bin/env bash
set -euo pipefail

# Security review acknowledgement:
# HANCORE-linux reviewed the privileged OpenVPN launch path and identified
# credential argv exposure, descriptor/path race conditions, and root execution
# risks from user-owned OpenVPN profiles.
# GitHub: https://github.com/HANCORE-linux

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/openvpn-lib
source "$script_dir/openvpn-lib"

cmd=${1:-status}
shift || true

# Root mode is the root-owned copy under /usr/local/lib/simpleopenvpn being run
# through pkexec. It is only allowed to perform the two privileged operations;
# a passwordless polkit rule must never turn into a general root shell.
openvpn_root_mode=0
openvpn_runner=()
if [[ ${EUID:-$(id -u)} -eq 0 && -n ${PKEXEC_UID:-} ]]; then
  openvpn_root_mode=1
  case "$cmd" in
    connect|disconnect) ;;
    *)
      echo "EasyOpenVPN: the privileged helper only supports connect and disconnect" >&2
      exit 1
      ;;
  esac
else
  openvpn_runner=(pkexec)
fi

# The unprivileged copy owns its state directory. The root copy must never
# create or chown paths inside the user's home: a symlinked parent could
# otherwise redirect that root write somewhere sensitive.
if [[ $openvpn_root_mode -eq 0 ]]; then
  openvpn_init_state
fi

case "$cmd" in
status)
  config=$(openvpn_selected_config 2>/dev/null || true)
  config_name=""
  [[ -n "$config" ]] && config_name=$(basename "$config")
  config_dir=$(openvpn_selected_dir 2>/dev/null || true)
  [[ -z "$config_dir" && -n "$config" ]] && config_dir=$(dirname "$config")

  configs_json="[]"
  auth_configs_json="[]"
	  mapfile -t saved_profiles < <(openvpn_known_profiles)
	  if [[ -d "$config_dir" ]]; then
	    mapfile -t conf_list < <(
	      {
	        printf '%s\n' "${saved_profiles[@]}"
	        find "$config_dir" -maxdepth 2 -type f \( -name '*.ovpn' -o -name '*.conf' \) 2>/dev/null | sort
	      } | grep -E '\.(ovpn|conf)$' | awk '!seen[$0]++'
	    )
	  else
	    conf_list=("${saved_profiles[@]}")
	  fi
	  if ((${#conf_list[@]} > 0)); then
	    configs_json=$(printf '%s\n' "${conf_list[@]}" | jq -R . | jq -s .)

	    auth_list=()
	    for c in "${conf_list[@]}"; do
	      if openvpn_profile_has_auth "$c"; then
	        auth_list+=("$c")
	      fi
	    done
	    if ((${#auth_list[@]} > 0)); then
	      auth_configs_json=$(printf '%s\n' "${auth_list[@]}" | jq -R . | jq -s .)
	    fi
	  fi

  is_running=false
  if openvpn_is_running; then
    is_running=true
  fi

  # "connected" means the tunnel is actually usable: the OpenVPN session
  # reported "Initialization Sequence Completed", the tun device exists, and it
  # has an IPv4 address. A running OpenVPN process that is still handshaking (or
  # stuck retrying) is reported as "connecting" instead.
  is_established=false
  is_connecting=false
  if [[ "$is_running" == true ]]; then
    if openvpn_tunnel_established; then
      is_established=true
    else
      is_connecting=true
    fi
  fi

  killswitch=false
  killswitch_enforced=false
  killswitch_reason=""
  killswitch_since=""
  if openvpn_killswitch_active; then
    killswitch=true
    killswitch_reason=$(openvpn_killswitch_reason 2>/dev/null || true)
    killswitch_since=$(openvpn_killswitch_since 2>/dev/null || true)
    if openvpn_killswitch_enforced; then
      killswitch_enforced=true
    fi
  fi

  # Passwordless connect/disconnect is available only after the one-time
  # setup-passwordless.sh installation.
  passwordless=false
  if openvpn_passwordless_available; then
    passwordless=true
  fi

  iface=$(openvpn_tun_iface || true)
  ip_addr=""
  [[ -n "$iface" ]] && ip_addr=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{ print $4; exit }' || true)

  bytes=""
  [[ -n "$iface" ]] && bytes=$(openvpn_bytes_text "$iface" 2>/dev/null || true)

  # Check credentials for active profile
  has_auth=false
  if openvpn_has_auth; then
    has_auth=true
  fi

  uname=$(openvpn_username 2>/dev/null || true)

  summary=$(openvpn_status_summary 2>/dev/null || true)

  log_tail=""
  if [[ -r "$openvpn_log_file" ]]; then
    log_tail=$(tail -n 12 "$openvpn_log_file" 2>/dev/null || true)
  fi

  jq -n \
    --argjson connected "$is_established" \
    --argjson running "$is_running" \
    --argjson connecting "$is_connecting" \
    --argjson blocked "$killswitch" \
    --argjson blocked_enforced "$killswitch_enforced" \
    --argjson passwordless "$passwordless" \
    --arg blocked_reason "${killswitch_reason:-}" \
    --arg blocked_since "${killswitch_since:-}" \
    --arg iface "${iface:-}" \
    --arg ip "${ip_addr:-}" \
    --arg config "${config:-}" \
    --arg config_name "${config_name:-}" \
    --arg config_dir "${config_dir:-}" \
    --argjson configs "$configs_json" \
    --argjson auth_configs "$auth_configs_json" \
    --argjson has_auth "$has_auth" \
    --arg username "${uname:-}" \
    --arg bytes_text "${bytes:-}" \
    --arg status_summary "${summary:-}" \
    --arg log_tail "${log_tail:-}" \
    '{
      connected: $connected,
      running: $running,
      connecting: $connecting,
      blocked: $blocked,
      blocked_enforced: $blocked_enforced,
      passwordless: $passwordless,
      blocked_reason: $blocked_reason,
      blocked_since: $blocked_since,
      iface: $iface,
      ip: $ip,
      config: $config,
      config_name: $config_name,
      config_dir: $config_dir,
      configs: $configs,
      auth_configs: $auth_configs,
      has_auth: $has_auth,
      username: $username,
      bytes_text: $bytes_text,
      status_summary: $status_summary,
      log_tail: $log_tail
    }'
  ;;

connect)
  # If the one-time passwordless setup is installed, hand the operation to the
  # root-owned copy. Its matching polkit rule authorizes it without a password.
  if openvpn_can_delegate; then
    exec pkexec "$openvpn_installed_ctl" connect
  fi
  config=$(openvpn_selected_config 2>/dev/null || true)
  if [[ -z "$config" || ! -r "$config" ]]; then
    echo "No valid config selected" >&2
    exit 1
  fi
  if openvpn_is_running; then
    echo "Already running"
    exit 0
  fi

  auth_f=$(openvpn_profile_auth_file "$config" 2>/dev/null || true)

  # Security boundary:
  #
  # OpenVPN needs root at startup to create/configure the tunnel device, but the
  # selected .ovpn/.conf file and saved credentials are controlled by the desktop
  # user. Treat every profile path, auth path, and config directive as untrusted
  # until the privileged Python helper below validates it.
  #
  # This helper was hardened after security review from HANCORE-linux, who
  # identified two important classes of bugs:
  #
  # 1. Secrets must not be passed as argv, because process command lines are
  #    visible through normal process inspection interfaces.
  # 2. A user-owned OpenVPN config must not be handed to a root OpenVPN process
  #    without blocking directives that can load privileged code or redirect
  #    privileged runtime files.
  #
  # OpenVPN reference:
  # https://openvpn.net/community-docs/community-articles/openvpn-2-6-manual.html
  "${openvpn_runner[@]}" /usr/bin/python3 - "$openvpn_uid" "$openvpn_gid" "$config" "$auth_f" "$openvpn_runtime_dir" <<'PY'
import os
import re
import select
import shlex
import signal
import stat
import subprocess
import sys
import time

uid = int(sys.argv[1])
gid = int(sys.argv[2])
config_path = sys.argv[3]
auth_source = sys.argv[4]
runtime_dir = sys.argv[5]
openvpn_bin = "/usr/bin/openvpn"

auth_path = os.path.join(runtime_dir, "auth-user-pass")
pid_path = os.path.join(runtime_dir, "openvpn.pid")
status_path = os.path.join(runtime_dir, "openvpn.status")
log_path = os.path.join(runtime_dir, "openvpn.log")
auth_name = os.path.basename(auth_path)
pid_name = os.path.basename(pid_path)
status_name = os.path.basename(status_path)
log_name = os.path.basename(log_path)

def fail(message):
    print(f"EasyOpenVPN: {message}", file=sys.stderr)
    raise SystemExit(1)

def ensure_runtime_dir():
    # Runtime file invariant:
    #
    # The user must be able to read OpenVPN status/log/pid outputs, but must not
    # be able to replace the directory with a symlink or race the privileged
    # helper into truncating arbitrary root-visible paths. Keep runtime files in
    # /run under a root-owned directory, then keep that directory open by fd for
    # every create/replace operation below.
    #
    # The directory mode is 0711 so the user can traverse to files they own while
    # other users cannot list the directory contents. Individual readable outputs
    # are created mode 0600 and chowned to the requesting user.
    parent = os.path.dirname(runtime_dir)
    parent_stat = os.stat(parent)
    if parent_stat.st_uid != 0 or parent_stat.st_mode & 0o022:
        fail(f"unsafe runtime parent: {parent}")

    try:
        st = os.lstat(runtime_dir)
    except FileNotFoundError:
        os.mkdir(runtime_dir, 0o711)
        st = os.lstat(runtime_dir)

    if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
        fail(f"unsafe runtime path: {runtime_dir}")
    if st.st_uid != 0:
        fail(f"runtime directory is not root-owned: {runtime_dir}")
    if stat.S_IMODE(st.st_mode) != 0o711:
        os.chmod(runtime_dir, 0o711)

    dir_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        dir_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        dir_flags |= os.O_NOFOLLOW
    runtime_fd = os.open(runtime_dir, dir_flags)
    runtime_stat = os.fstat(runtime_fd)
    if not stat.S_ISDIR(runtime_stat.st_mode) or runtime_stat.st_uid != 0 or stat.S_IMODE(runtime_stat.st_mode) != 0o711:
        os.close(runtime_fd)
        fail(f"unsafe runtime directory: {runtime_dir}")
    return runtime_fd

def open_user_file(path, required):
    # Descriptor invariant:
    #
    # Open the user-supplied config/auth file exactly once with O_NOFOLLOW and
    # validate the opened object with fstat(). After that, pass the descriptor
    # forward. Do not validate by path and then reopen by path; HANCORE-linux
    # correctly called out that pattern as check-then-use race-prone.
    if not path:
        if required:
            fail("missing required file path")
        return None
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        if required:
            fail(f"file not found: {path}")
        return None
    except OSError as exc:
        if required:
            fail(f"cannot open file safely: {path}: {exc}")
        return None

    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        os.close(fd)
        fail(f"not a regular file: {path}")
    if st.st_uid != uid:
        os.close(fd)
        fail(f"file is not owned by requesting user: {path}")
    return fd

def secure_replace(dir_fd, name, data, mode, owner_uid, owner_gid):
    # Atomic runtime publishing:
    #
    # Create a fresh temp file below the already-verified runtime dir_fd, fsync
    # the file, then rename it into place relative to the same directory fd. This
    # avoids symlink following and directory replacement races while preserving an
    # all-or-nothing update for auth/log/status/pid files.
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    tmp = None
    fd = None
    for attempt in range(100):
        candidate = f".{name}.tmp.{os.getpid()}.{attempt}"
        try:
            fd = os.open(candidate, flags, mode, dir_fd=dir_fd)
            tmp = candidate
            break
        except FileExistsError:
            continue
    if fd is None:
        fail(f"could not create temporary file for {name}")

    try:
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fchown(fd, owner_uid, owner_gid)
        os.fchmod(fd, mode)
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)
        tmp = None
    finally:
        if fd is not None:
            os.close(fd)
        if tmp is not None:
            try:
                os.unlink(tmp, dir_fd=dir_fd)
            except FileNotFoundError:
                pass

def validate_root_executable(path):
    st = os.stat(path)
    if not stat.S_ISREG(st.st_mode):
        fail(f"not a regular executable: {path}")
    if st.st_uid != 0 or st.st_mode & 0o022:
        fail(f"unsafe executable permissions: {path}")
    if not os.access(path, os.X_OK):
        fail(f"executable is not runnable: {path}")

def read_fd(fd, max_bytes=65536):
    chunks = []
    total = 0
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        total += len(chunk)
        if total > max_bytes:
            fail("credential file is too large")
        chunks.append(chunk)
    return b"".join(chunks)

def validate_openvpn_config_fd(fd, label):
    # Privileged config policy:
    #
    # OpenVPN accepts most command-line options inside config files, with the
    # leading "--" removed. Because this profile is user-owned but later parsed by
    # a root OpenVPN process, validate the already-open descriptor before launch.
    #
    # Reviewer contribution:
    # HANCORE-linux noted that --script-security 1 does not block OpenVPN's
    # "plugin" directive. The same trust-boundary reasoning applies to every
    # directive that makes the root OpenVPN process load code/modules, run
    # commands, open user-selected privileged control surfaces, or read/write
    # profile-supplied paths. This policy intentionally rejects those directives
    # even if that means some advanced profiles are unsupported.
    #
    # References:
    # - OpenVPN 2.6 manual, "OPTIONS": config files can contain command options.
    # - OpenVPN 2.6 manual, "Plug-in Interface Options": plugin loads modules.
    # - OpenVPN 2.6/2.7 manuals, "PKCS#11 Options": pkcs11-providers loads a
    #   provider shared library.
    # - OpenVPN 2.6 manual, "Management Interface Options": management exposes
    #   control over the OpenVPN process and must not be enabled by profiles here.
    os.lseek(fd, 0, os.SEEK_SET)
    in_inline = None
    inline_options = {
        "ca", "cert", "dh", "extra-certs", "http-proxy-user-pass", "key",
        "pkcs12", "secret", "tls-auth", "tls-crypt", "tls-crypt-v2",
    }
    forbidden_directives = {
        "auth-gen-token", "auth-user-pass-optional", "auth-user-pass-verify",
        "client-connect", "client-disconnect", "client-to-client",
        "connect-freq", "connect-freq-initial", "dns-updown", "down",
        "duplicate-cn", "hash-size", "ipchange", "iproute", "learn-address",
        "max-clients", "max-routes-per-client", "route-pre-down", "route-up",
        "script-security", "setcon", "stale-routes-check", "tcp-nodelay",
        "tcp-queue-limit", "tls-crypt-v2-verify", "tls-server", "tls-verify",
        "up",
        "engine", "pkcs11-id-management", "pkcs11-providers", "plugin",
        "providers",
        "auth-gen-token-secret", "ca", "capath", "cd", "cert", "chroot",
        "client-config-dir", "config", "crl-verify", "daemon", "dev-node", "dh",
        "extra-certs", "genkey", "http-proxy", "http-proxy-user-pass",
        "ifconfig-pool", "ifconfig-pool-persist", "ifconfig-push",
        "ifconfig-ipv6-pool", "ifconfig-ipv6-push", "iroute", "iroute-ipv6",
        "key", "log", "log-append", "mktun", "override-username", "pkcs12",
        "port-share", "push", "push-remove", "push-reset", "replay-persist",
        "rmtun", "secret", "server", "server-bridge", "server-ipv6",
        "show-engines", "show-pkcs11-ids", "socks-proxy", "status", "syslog",
        "tls-auth", "tls-crypt", "tls-crypt-v2", "tls-export-cert", "tmp-dir",
        "username-as-common-name", "verify-client-cert", "writepid",
    }
    forbidden_prefixes = ("management",)

    config_file = None
    try:
        config_file = os.fdopen(os.dup(fd), "r", encoding="utf-8", errors="replace")
        for lineno, raw in enumerate(config_file, 1):
            line = raw.strip()
            if not line or line.startswith("#") or line.startswith(";"):
                continue

            if in_inline is not None:
                # Inline certificate/key blocks can contain arbitrary text. Do
                # not interpret a word such as "plugin" inside certificate data
                # as an OpenVPN directive.
                if line.lower() == f"</{in_inline}>":
                    in_inline = None
                continue

            if line.startswith("<") and line.endswith(">") and not line.startswith("</"):
                tag = line[1:-1].strip().lower()
                if tag in inline_options:
                    in_inline = tag
                continue

            try:
                parts = shlex.split(line, comments=True, posix=True)
            except ValueError as exc:
                fail(f"cannot parse OpenVPN config {label}:{lineno}: {exc}")
            if not parts:
                continue

            directive = parts[0].lower().lstrip("-")
            if directive in forbidden_directives or directive.startswith(forbidden_prefixes):
                fail(f"OpenVPN directive is not allowed: {directive} at {label}:{lineno}")
            if directive == "mode" and len(parts) > 1 and parts[1].lower() == "server":
                fail(f"OpenVPN server mode is not allowed at {label}:{lineno}")
            if directive == "proto" and len(parts) > 1 and "server" in parts[1].lower():
                fail(f"OpenVPN server protocol is not allowed at {label}:{lineno}")
            if directive in ("auth-user-pass", "askpass") and len(parts) > 1:
                fail(f"OpenVPN credential file directive is not allowed: {directive} at {label}:{lineno}")
            if directive == "setenv" and len(parts) >= 3 and parts[1].lower() == "opt":
                deferred = parts[2].lower().lstrip("-")
                if deferred in forbidden_directives or deferred.startswith(forbidden_prefixes) or deferred in ("auth-user-pass", "askpass"):
                    fail(f"deferred OpenVPN directive is not allowed: {deferred} at {label}:{lineno}")

        if in_inline is not None:
            fail(f"unterminated inline block <{in_inline}> in OpenVPN config {label}")
    finally:
        if config_file is not None:
            config_file.close()
        os.lseek(fd, 0, os.SEEK_SET)

# ---------------------------------------------------------------------------
# Kill switch
# ---------------------------------------------------------------------------
#
# The connection is supervised by a root helper that is forked off after
# OpenVPN starts and outlives pkexec. It watches the OpenVPN process, the
# tunnel device and the OpenVPN log. If a tunnel that had reached
# "Initialization Sequence Completed" disappears, it immediately:
#
#   1. installs an nftables table that drops all input/forward/output traffic
#      except loopback (no leaks outside the tunnel), and
#   2. terminates OpenVPN, then
#   3. records why in the runtime directory so the panel can explain the state.
#
# The rules are only removed by an explicit disconnect/restore action, which
# also stops the guard, so a failed VPN can never silently fall back to the
# physical network.

KILLSWITCH_RULESET = """\
add table inet simpleopenvpn
add chain inet simpleopenvpn input { type filter hook input priority 0; policy drop; }
add rule inet simpleopenvpn input iifname "lo" accept
add chain inet simpleopenvpn output { type filter hook output priority 0; policy drop; }
add rule inet simpleopenvpn output oifname "lo" accept
add chain inet simpleopenvpn forward { type filter hook forward priority 0; policy drop; }
"""

LOSS_MARKERS = (
    "connection reset, restarting",
    "restart pause",
    "sigusr1[",
    "sigterm[",
    "process exiting",
    "auth_failed",
    "inactivity timeout",
    "tls error",
    "tls key negotiation failed",
    "verification failed",
    "cipher negotiation failed",
)

# A connection attempt that has not reached "Initialization Sequence Completed"
# within this many seconds is aborted. Because no tunnel was established, this
# path stops OpenVPN but intentionally does NOT engage the kill switch.
CONNECT_TIMEOUT = 9.0


def trusted_root_executable(path):
    try:
        st = os.stat(path)
    except OSError:
        return False
    return (
        stat.S_ISREG(st.st_mode)
        and st.st_uid == 0
        and not (st.st_mode & 0o022)
        and os.access(path, os.X_OK)
    )


def find_nft():
    for candidate in ("/usr/bin/nft", "/usr/sbin/nft", "/sbin/nft", "/bin/nft"):
        if trusted_root_executable(candidate):
            return candidate
    return None


def nft_run(nft, args, data=None, timeout=15):
    try:
        return subprocess.run(
            [nft] + args,
            input=data,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError):
        return None


def _open_runtime_dir_fd(runtime_dir):
    # Re-open and re-validate the runtime directory. Used by the guard child
    # process after it has closed the fd inherited from the parent, and by
    # engage_killswitch which may not have a live dir_fd in scope.
    dir_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        dir_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        dir_flags |= os.O_NOFOLLOW
    try:
        fd = os.open(runtime_dir, dir_flags)
    except OSError:
        return None
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o711:
        os.close(fd)
        return None
    return fd


def write_runtime_text(runtime_dir, name, text, mode):
    # The runtime directory is root-owned and not writable by the desktop user,
    # so a pre-planted symlink cannot redirect these root writes. Publish with
    # rename relative to an already-verified dir_fd so the unprivileged status
    # command never reads a partial file, and so the rename itself cannot be
    # redirected by a concurrent directory replacement.
    # SEC-2 fix: use dir_fd-relative open/rename consistently with secure_replace().
    dir_fd = _open_runtime_dir_fd(runtime_dir)
    if dir_fd is None:
        raise OSError(f"cannot open runtime directory: {runtime_dir}")
    tmp_name = f".{name}.tmp.{os.getpid()}"
    write_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        write_flags |= os.O_NOFOLLOW
    fd = None
    try:
        fd = os.open(tmp_name, write_flags, mode, dir_fd=dir_fd)
        os.fchown(fd, 0, 0)
        os.fchmod(fd, mode)
        view = memoryview(text.encode())
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(tmp_name, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    finally:
        if fd is not None:
            os.close(fd)
        try:
            os.unlink(tmp_name, dir_fd=dir_fd)
        except FileNotFoundError:
            pass
        os.close(dir_fd)


def wait_pidfd_exit(pidfd, timeout):
    poller = select.poll()
    poller.register(pidfd, select.POLLIN)
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        if poller.poll(min(remaining, 0.1) * 1000):
            return True


def terminate_pid(pid, pidfd, timeout=3.0):
    try:
        signal.pidfd_send_signal(pidfd, signal.SIGTERM)
    except ProcessLookupError:
        return
    if wait_pidfd_exit(pidfd, timeout):
        return
    try:
        signal.pidfd_send_signal(pidfd, signal.SIGKILL)
    except ProcessLookupError:
        pass


def process_comm(pid):
    try:
        with open(f"/proc/{pid}/comm", "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return ""


def stop_stale_guard(guard_pid_path):
    # Disconnect and reconnect use the same marker: a guard that sees it exits
    # without engaging the kill switch, even if OpenVPN dies while we stop it.
    try:
        with open(guard_pid_path, "r", encoding="utf-8") as handle:
            pid_text = handle.read().strip()
    except OSError:
        return
    if pid_text.isdecimal():
        pid = int(pid_text)
        try:
            pidfd = os.pidfd_open(pid)
        except OSError:
            pidfd = None
        if pidfd is not None:
            try:
                if process_comm(pid) == "openvpn-guard":
                    try:
                        signal.pidfd_send_signal(pidfd, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                    if not wait_pidfd_exit(pidfd, 2.0):
                        try:
                            signal.pidfd_send_signal(pidfd, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                        wait_pidfd_exit(pidfd, 1.0)
            finally:
                os.close(pidfd)
    try:
        os.unlink(guard_pid_path)
    except FileNotFoundError:
        pass


def iface_has_ipv4(name):
    try:
        result = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", "dev", name],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        # If the check itself failed, do not create a kill-switch event out of
        # thin air; the process and log watchdogs still cover this session.
        return True
    return result.returncode == 0 and " inet " in result.stdout


def find_tun_iface():
    try:
        names = sorted(os.listdir("/sys/class/net"))
    except OSError:
        return ""
    for name in names:
        if re.match(r"^(tun|tap)[0-9]+$", name) and iface_has_ipv4(name):
            return name
    return ""


def set_process_name(name):
    try:
        import ctypes

        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.prctl(15, ctypes.c_char_p(name.encode()), 0, 0, 0)
    except Exception:
        pass


def engage_killswitch(nft, killswitch_path, auth_path, openvpn_pid, pidfd, reason, stop_path=None):
    if stop_path and os.path.exists(stop_path):
        return
    result = nft_run(nft, ["-f", "-"], KILLSWITCH_RULESET)
    enforced = bool(result is not None and result.returncode == 0)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    try:
        write_runtime_text(
            os.path.dirname(killswitch_path),
            os.path.basename(killswitch_path),
            f"{reason}\n{stamp}\n{1 if enforced else 0}\n",
            0o644,
        )
    except OSError:
        pass
    terminate_pid(openvpn_pid, pidfd)
    try:
        os.unlink(auth_path)
    except FileNotFoundError:
        pass


def guard_loop(openvpn_pid, pidfd, nft, log_path, stop_path, killswitch_path, auth_path):
    state = "waiting"
    iface = ""
    offset = 0
    pending = ""
    deadline = time.monotonic() + CONNECT_TIMEOUT
    poller = select.poll()
    poller.register(pidfd, select.POLLIN)

    while True:
        if os.path.exists(stop_path):
            return
        if poller.poll(250):
            if os.path.exists(stop_path):
                return
            if state == "up":
                engage_killswitch(
                    nft,
                    killswitch_path,
                    auth_path,
                    openvpn_pid,
                    pidfd,
                    "OpenVPN process exited unexpectedly",
                    stop_path,
                )
            return

        data = ""
        try:
            size = os.path.getsize(log_path)
            if size < offset:
                offset = 0
                pending = ""
            with open(log_path, "r", encoding="utf-8", errors="replace") as handle:
                handle.seek(offset)
                data = handle.read()
                offset = handle.tell()
        except OSError:
            data = ""

        # Only interpret complete lines: a read can land in the middle of a log
        # line, and a marker such as "Initialization Sequence Completed" must not
        # be missed just because it was split across two reads.
        pending += data
        if "\n" in pending:
            lines = pending.split("\n")
            pending = lines.pop()
        else:
            lines = []
        if len(pending) > 65536:
            pending = pending[-65536:]

        for raw in lines:
            line = raw.strip()
            if not line:
                continue
            low = line.lower()
            # OpenVPN 2.7 logs the device twice: "TUN/TAP device tun0 opened"
            # and "tun/tap device [tun0] opened". Strip brackets and whitespace
            # so the interface check does not look for a non-existent "[tun0]" device.
            opened = re.search(r"(?:TUN/TAP|DCO) device\s+(\S+)\s+opened", line, re.IGNORECASE)
            if opened:
                dev_name = opened.group(1).strip("[] \t\r\n'\"")
                if dev_name:
                    iface = dev_name
                continue
            if state == "waiting":
                if "initialization sequence completed" in low:
                    state = "up"
                    if not iface or not os.path.exists(os.path.join("/sys/class/net", iface)):
                        iface = find_tun_iface()
                continue
            for marker in LOSS_MARKERS:
                if marker in low:
                    if os.path.exists(stop_path):
                        return
                    engage_killswitch(
                        nft,
                        killswitch_path,
                        auth_path,
                        openvpn_pid,
                        pidfd,
                        f"VPN server connection lost: {line[:160]}",
                        stop_path,
                    )
                    return

        now = time.monotonic()
        if state == "waiting":
            if now > deadline:
                # The handshake never completed, so there is no tunnel to
                # protect and no reason to cut the whole network.
                terminate_pid(openvpn_pid, pidfd)
                return
            continue

        if iface and not os.path.exists(os.path.join("/sys/class/net", iface)):
            # A reconnect can bring the tunnel back on a different tunN device.
            # Give a brief grace period before checking other interfaces, and only
            # call it a loss when no tunnel holding an IPv4 address remains.
            time.sleep(0.5)
            current = find_tun_iface()
            if current:
                iface = current
            elif not os.path.exists(os.path.join("/sys/class/net", iface)):
                if os.path.exists(stop_path):
                    return
                engage_killswitch(
                    nft,
                    killswitch_path,
                    auth_path,
                    openvpn_pid,
                    pidfd,
                    f"Tunnel interface {iface} disappeared",
                    stop_path,
                )
                return


def remove_own_pid_file(guard_pid_path):
    try:
        with open(guard_pid_path, "r", encoding="utf-8") as handle:
            current = handle.read().strip()
    except OSError:
        return
    if current != str(os.getpid()):
        return
    try:
        os.unlink(guard_pid_path)
    except FileNotFoundError:
        pass


def spawn_guard(runtime_fd, openvpn_pid, nft, log_path, stop_path, killswitch_path, auth_path, guard_pid_path):
    try:
        child = os.fork()
    except OSError as exc:
        # Do not leave an unsupervised tunnel behind if the guard cannot start.
        try:
            os.kill(openvpn_pid, signal.SIGTERM)
        except OSError:
            pass
        fail(f"cannot start the kill switch guard: {exc}")
    if child != 0:
        return

    # Detach from pkexec before doing any long-lived work.
    try:
        try:
            os.close(runtime_fd)
        except OSError:
            pass
        os.setsid()
        devnull = os.open(os.devnull, os.O_RDWR)
        for target in (0, 1, 2):
            os.dup2(devnull, target)
        if devnull > 2:
            os.close(devnull)
        set_process_name("openvpn-guard")
        # The guard is still useful without its pid file: disconnect also
        # signals an intentional stop through the stop marker.
        try:
            write_runtime_text(os.path.dirname(guard_pid_path), os.path.basename(guard_pid_path), f"{os.getpid()}\n", 0o600)
        except OSError:
            pass
        pidfd = os.pidfd_open(openvpn_pid)
        try:
            guard_loop(openvpn_pid, pidfd, nft, log_path, stop_path, killswitch_path, auth_path)
        finally:
            os.close(pidfd)
    except Exception:
        pass
    finally:
        remove_own_pid_file(guard_pid_path)
        os._exit(0)


runtime_fd = ensure_runtime_dir()
validate_root_executable(openvpn_bin)
nft = find_nft()
if nft is None:
    os.close(runtime_fd)
    fail("nftables (nft) is required for the kill switch")

config_fd = open_user_file(config_path, True)
auth_fd = open_user_file(auth_source, False)
validate_openvpn_config_fd(config_fd, config_path)

guard_pid_path = os.path.join(runtime_dir, "guard.pid")
killswitch_path = os.path.join(runtime_dir, "killswitch")
stop_path = os.path.join(runtime_dir, "stop-requested")

# Connecting is an explicit user action, so clear any kill switch left over from
# a previous session before launching a new tunnel.
secure_replace(runtime_fd, "stop-requested", b"1\n", 0o600, 0, 0)
stop_stale_guard(guard_pid_path)
nft_run(nft, ["delete", "table", "inet", "simpleopenvpn"])
