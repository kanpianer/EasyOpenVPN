os.close(runtime_fd)
PY
  echo "connected"
  ;;

disconnect)
  # Disconnecting is also the "restore the network" action: the kill switch
  # needs root to be torn down even when OpenVPN is already gone, so only skip
  # the privileged helper when there is genuinely nothing to clean up.
  if ! openvpn_is_running && [[ ! -e "$openvpn_killswitch_file" ]] && [[ ! -e "$openvpn_guard_pid_file" ]]; then
    echo "Not running"
    exit 0
  fi
  if openvpn_can_delegate; then
    exec pkexec "$openvpn_installed_ctl" disconnect
  fi
  pids=$(openvpn_matching_pids || true)
  pid_args=()
  if [[ -n "$pids" ]]; then
    mapfile -t pid_args <<<"$pids"
  fi
  "${openvpn_runner[@]}" /usr/bin/python3 - "$openvpn_runtime_dir" "$openvpn_pid_file" "$openvpn_auth_file" "${pid_args[@]}" <<'PY'
import os
import select
import signal
import stat
import subprocess
import sys
import time

runtime_dir = sys.argv[1]
pid_path = sys.argv[2]
auth_path = sys.argv[3]
pids = sys.argv[4:]
auth_name = os.path.basename(auth_path)

def fail(message):
    print(f"EasyOpenVPN: {message}", file=sys.stderr)
    raise SystemExit(1)

if not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal"):
    fail("pidfd support is required for privileged disconnect")

def ensure_runtime_dir():
    parent = os.path.dirname(runtime_dir)
    parent_stat = os.stat(parent)
    if parent_stat.st_uid != 0 or parent_stat.st_mode & 0o022:
        fail(f"unsafe runtime parent: {parent}")

    dir_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        dir_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        dir_flags |= os.O_NOFOLLOW

    fd = os.open(runtime_dir, dir_flags)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o711:
        os.close(fd)
        fail(f"unsafe runtime directory: {runtime_dir}")
    return fd

def pidfd_current_pid(pidfd):
    try:
        with open(f"/proc/self/fdinfo/{pidfd}", "r", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("Pid:"):
                    return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        return -1
    return -1

def open_target_openvpn_pidfd(pid):
    if not pid.isdecimal():
        return None
    numeric_pid = int(pid)
    try:
        pidfd = os.pidfd_open(numeric_pid, 0)
    except OSError:
        return None

    proc = f"/proc/{pid}"
    try:
        with open(os.path.join(proc, "comm"), "r", encoding="utf-8") as handle:
            if handle.read().strip() != "openvpn":
                os.close(pidfd)
                return None
        with open(os.path.join(proc, "cmdline"), "rb") as handle:
            argv = [arg.decode("utf-8", "replace") for arg in handle.read().split(b"\0") if arg]
    except OSError:
        os.close(pidfd)
        return None

    if pidfd_current_pid(pidfd) != numeric_pid:
        os.close(pidfd)
        return None

    for index, arg in enumerate(argv[:-1]):
        if arg == "--writepid" and argv[index + 1] == pid_path:
            return pidfd
    os.close(pidfd)
    return None

def wait_pidfd_exit(pidfd, timeout):
    poller = select.poll()
    poller.register(pidfd, select.POLLIN)
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        if poller.poll(min(remaining, 0.1) * 1000):
            return True

def process_comm(pid):
    try:
        with open(f"/proc/{pid}/comm", "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return ""

def trusted_root_executable(path):
    try:
        st = os.stat(path)
    except OSError:
        return False
    return (
        stat.S_ISREG(st.st_mode)
        and st.st_uid == 0
        and not (st.st_mode & 0o022)
        and os.access(path, os.X_OK)
    )

def find_nft():
    for candidate in ("/usr/bin/nft", "/usr/sbin/nft", "/sbin/nft", "/bin/nft"):
        if trusted_root_executable(candidate):
            return candidate
    return None

def nft_run(nft, args):
    try:
        return subprocess.run(
            [nft] + args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        return None

def stop_guard():
    guard_pid_path = os.path.join(runtime_dir, "guard.pid")
    try:
        with open(guard_pid_path, "r", encoding="utf-8") as handle:
            pid_text = handle.read().strip()
    except OSError:
        return
    if pid_text.isdecimal():
        pid = int(pid_text)
        try:
            pidfd = os.pidfd_open(pid)
        except OSError:
            pidfd = None
        if pidfd is not None:
            try:
                if process_comm(pid) == "openvpn-guard":
                    try:
                        signal.pidfd_send_signal(pidfd, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                    if not wait_pidfd_exit(pidfd, 2.0):
                        try:
                            signal.pidfd_send_signal(pidfd, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                        wait_pidfd_exit(pidfd, 1.0)
            finally:
                os.close(pidfd)
    try:
        os.unlink(guard_pid_path)
    except FileNotFoundError:
        pass

runtime_fd = ensure_runtime_dir()
try:
    # Announce an intentional stop before OpenVPN goes away. The guard checks
    # this marker every 250 ms and also right before it would block the network.
    marker_flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    if hasattr(os, "O_NOFOLLOW"):
        marker_flags |= os.O_NOFOLLOW
    marker_fd = os.open("stop-requested", marker_flags, 0o600, dir_fd=runtime_fd)
    try:
        os.write(marker_fd, b"1\n")
        os.fsync(marker_fd)
    finally:
        os.close(marker_fd)

    stop_guard()

    for pid in pids:
        pidfd = open_target_openvpn_pidfd(pid)
        if pidfd is not None:
            try:
                signal.pidfd_send_signal(pidfd, signal.SIGTERM)
            except ProcessLookupError:
                pass
            finally:
                os.close(pidfd)

    nft = find_nft()
    if nft is not None:
        nft_run(nft, ["delete", "table", "inet", "simpleopenvpn"])

    if auth_name != "auth-user-pass":
        fail("unexpected auth file name")
    for name in ("killswitch", "guard.pid", "stop-requested"):
        try:
            os.unlink(name, dir_fd=runtime_fd)
        except FileNotFoundError:
            pass
    try:
        os.unlink(auth_name, dir_fd=runtime_fd)
    except FileNotFoundError:
        pass
finally:
    os.close(runtime_fd)
PY
  echo "disconnected"
  ;;

toggle)
  if openvpn_is_running; then
    "$0" disconnect
  else
    "$0" connect
  fi
  ;;

set_config)
  new_conf=${1:?Usage: set_config <path>}
  if [[ ! -r "$new_conf" ]]; then
    echo "File unreadable: $new_conf" >&2
    exit 1
  fi
	  openvpn_secure_write_line "$openvpn_config_file" "$new_conf"
	  openvpn_secure_write_line "$openvpn_config_dir_file" "$(dirname "$new_conf")"
	  openvpn_remember_profile "$new_conf"
	  echo "ok"
	  ;;

set_order|save_order)
  new_order=()
  if [[ $# -gt 0 ]]; then
    new_order=("$@")
  else
    while IFS= read -r line; do
      [[ -n "$line" ]] && new_order+=("$line")
    done
  fi
  if ((${#new_order[@]} > 0)); then
    openvpn_init_state
    printf '%s\n' "${new_order[@]}" | awk '!seen[$0]++' | openvpn_atomic_publish "$openvpn_profiles_file"
  fi
  echo "ok"
  ;;

remove_profile|remove_profiles)
  # Deleting nodes removes .ovpn files from the user's profile list.
  # Accepts one or multiple paths. Trashes the files when gio is available.
  targets=("$@")
  if [[ ${#targets[@]} -eq 0 ]]; then
    echo "Usage: remove_profile <path> [path...]" >&2
    exit 1
  fi
  for target in "${targets[@]}"; do
    [[ -z "$target" ]] && continue
    if [[ -L $target || ! -f $target ]]; then
      continue
    fi
    real_target=$(realpath -e -- "$target" 2>/dev/null || true)
    [[ -z "$real_target" || ! -r "$real_target" ]] && continue
    case "$real_target" in
      *.ovpn|*.conf) ;;
      *) continue ;;
    esac
    if ! openvpn_all_profiles | grep -Fxq -- "$real_target"; then
      continue
    fi

    # Forget the remembered entry and any stored credentials for the profile.
    if [[ -r "$openvpn_profiles_file" ]]; then
      grep -Fxv -e "$target" -e "$real_target" "$openvpn_profiles_file" 2>/dev/null |
        awk '!seen[$0]++' | openvpn_atomic_publish "$openvpn_profiles_file" || true
    fi
    auth_f=$(openvpn_profile_auth_file "$real_target" 2>/dev/null || true)
    [[ -n "$auth_f" ]] && rm -f -- "$auth_f"

    if command -v gio &>/dev/null && gio trash -- "$real_target" 2>/dev/null; then
      :
    else
      rm -f -- "$real_target"
    fi
  done

  # Move the selection to the next remaining node when the deleted one was
  # selected, so the panel never points at a file that no longer exists.
  current_selected=$(openvpn_selected_config 2>/dev/null || true)
  if [[ -n "$current_selected" && ! -r "$current_selected" ]]; then
    next=""
    while IFS= read -r candidate; do
      [[ -n "$candidate" && -r "$candidate" ]] || continue
      next="$candidate"
      break
    done < <(openvpn_all_profiles)
    if [[ -n "$next" ]]; then
      openvpn_secure_write_line "$openvpn_config_file" "$next"
      openvpn_secure_write_line "$openvpn_config_dir_file" "$(dirname -- "$next")"
    else
      rm -f -- "$openvpn_config_file" "$openvpn_config_dir_file"
    fi
  fi
  echo "ok"
  ;;

set_config_dir)
  new_dir=${1:?Usage: set_config_dir <path>}
  new_dir="${new_dir/#\~/$HOME}"
  if [[ ! -d "$new_dir" ]]; then
    echo "Directory not found: $new_dir" >&2
    exit 1
  fi
  openvpn_secure_write_line "$openvpn_config_dir_file" "$new_dir"
  echo "ok"
  ;;

pick_file|add_profile)
  start_dir=$(openvpn_selected_dir 2>/dev/null || true)
  if [[ -z "$start_dir" || ! -d "$start_dir" ]]; then
    if [[ -d "$HOME/Downloads" ]]; then
      start_dir="$HOME/Downloads"
    else
      start_dir="$HOME"
    fi
  fi

  files_raw=""
  if command -v zenity &>/dev/null; then
    files_raw=$(zenity --file-selection --multiple --separator=$'\n' \
      --title="Add OpenVPN Profiles" \
      ${start_dir:+--filename="$start_dir/"} \
      --file-filter="OpenVPN Config (*.ovpn *.conf) | *.ovpn *.conf *.OVPN *.CONF" \
      --file-filter="All Files (*.*) | *" 2>/dev/null || true)
  elif command -v omarchy-file-select &>/dev/null; then
    files_raw=$(omarchy-file-select --title "Add OpenVPN Profiles" --multiple --extensions "ovpn conf" 2>/dev/null || true)
  fi

  found_files=()
  if [[ -n "$files_raw" ]]; then
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      if [[ -f "$f" && -r "$f" ]]; then
        case "${f,,}" in
          *.ovpn|*.conf)
            found_files+=("$f")
            ;;
        esac
      fi
    done <<< "$files_raw"
  fi

  if ((${#found_files[@]} > 0)); then
    openvpn_remember_profiles "${found_files[@]}"

    first_file="${found_files[0]}"

    current_selected=$(openvpn_selected_config 2>/dev/null || true)
    if [[ -z "$current_selected" || ! -r "$current_selected" ]]; then
      openvpn_secure_write_line "$openvpn_config_file" "$first_file"
    elif ! openvpn_tunnel_established && ! openvpn_process_alive; then
      openvpn_secure_write_line "$openvpn_config_file" "$first_file"
    fi
    echo "imported ${#found_files[@]} profiles"
  else
    echo "cancelled"
  fi
  ;;

open_folder|pick_folder|import_folder)
  start_dir=$(openvpn_selected_dir 2>/dev/null || true)
  if [[ -z "$start_dir" || ! -d "$start_dir" ]]; then
    if [[ -d "$HOME/Downloads" ]]; then
      start_dir="$HOME/Downloads"
    else
      start_dir="$HOME"
    fi
  fi

  selected_dir=""
  if command -v zenity &>/dev/null; then
    selected_dir=$(zenity --file-selection --directory \
      --title="Select Folder with OpenVPN Profiles" \
      ${start_dir:+--filename="$start_dir/"} 2>/dev/null || true)
  elif command -v omarchy-file-select &>/dev/null; then
    selected_dir=$(omarchy-file-select --title "Select Folder with OpenVPN Profiles" --directory 2>/dev/null || true)
  fi

  if [[ -n "$selected_dir" && -d "$selected_dir" ]]; then
    selected_dir=$(realpath -e -- "$selected_dir" 2>/dev/null || echo "$selected_dir")
    openvpn_secure_write_line "$openvpn_config_dir_file" "$selected_dir"

    found_files=()
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      if [[ -f "$f" && -r "$f" ]]; then
        found_files+=("$f")
      fi
    done < <(find -L "$selected_dir" -maxdepth 4 -type f \( -name '*.ovpn' -o -name '*.conf' -o -name '*.OVPN' -o -name '*.CONF' \) ! -path '*/.*' 2>/dev/null | sort)

    if ((${#found_files[@]} > 0)); then
      openvpn_remember_profiles "${found_files[@]}"

      current_selected=$(openvpn_selected_config 2>/dev/null || true)
      if [[ -z "$current_selected" || ! -r "$current_selected" ]]; then
        openvpn_secure_write_line "$openvpn_config_file" "${found_files[0]}"
      elif ! openvpn_tunnel_established && ! openvpn_process_alive; then
        openvpn_secure_write_line "$openvpn_config_file" "${found_files[0]}"
      fi
      echo "imported ${#found_files[@]} profiles from $selected_dir"
    else
      echo "no profiles found in $selected_dir"
    fi
  else
    echo "cancelled"
  fi
  ;;

set_credentials)
  IFS= read -r uname || {
    echo "Usage: set_credentials < username/password/profile on stdin >" >&2
    exit 1
  }
  IFS= read -r passwd || passwd=""
  IFS= read -r target_conf || target_conf=""
  if [[ -z "$target_conf" ]]; then
    target_conf=$(openvpn_selected_config 2>/dev/null || true)
  fi

  # Save profile-specific auth file
  if [[ -n "$target_conf" ]]; then
    auth_f=$(openvpn_profile_auth_file "$target_conf" 2>/dev/null || true)
    if [[ -n "$auth_f" ]]; then
      openvpn_secure_write_auth "$auth_f" "$uname" "$passwd"
    fi
  fi

  # Save fallback/global username
  openvpn_secure_write_line "$openvpn_username_file" "$uname"

  echo "ok"
  ;;

clear_credentials)
  target_conf=${1:-}
  if [[ -z "$target_conf" ]]; then
    target_conf=$(openvpn_selected_config 2>/dev/null || true)
  fi

  if [[ -n "$target_conf" ]]; then
    auth_f=$(openvpn_profile_auth_file "$target_conf" 2>/dev/null || true)
    [[ -n "$auth_f" ]] && rm -f "$auth_f"
  fi
  pkexec /usr/bin/python3 - "$openvpn_runtime_dir" "$openvpn_auth_file" <<'PY' 2>/dev/null || true
import os
import stat
import sys

runtime_dir = sys.argv[1]
auth_path = sys.argv[2]
auth_name = os.path.basename(auth_path)
if auth_name != "auth-user-pass":
    raise SystemExit(1)

dir_flags = os.O_RDONLY
if hasattr(os, "O_DIRECTORY"):
    dir_flags |= os.O_DIRECTORY
if hasattr(os, "O_NOFOLLOW"):
    dir_flags |= os.O_NOFOLLOW

fd = os.open(runtime_dir, dir_flags)
try:
    st = os.fstat(fd)
    if stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and stat.S_IMODE(st.st_mode) == 0o711:
        try:
            os.unlink(auth_name, dir_fd=fd)
        except FileNotFoundError:
            pass
finally:
    os.close(fd)
PY
  echo "ok"
  ;;

*)
  echo "Unknown command: $cmd" >&2
  exit 1
  ;;
esac
