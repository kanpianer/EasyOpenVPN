    os.unlink("killswitch", dir_fd=runtime_fd)
except FileNotFoundError:
    pass
try:
    os.unlink("guard.pid", dir_fd=runtime_fd)
except FileNotFoundError:
    pass
try:
    os.unlink("stop-requested", dir_fd=runtime_fd)
except FileNotFoundError:
    pass

secure_replace(runtime_fd, log_name, b"", 0o600, uid, gid)
secure_replace(runtime_fd, status_name, b"", 0o600, uid, gid)
secure_replace(runtime_fd, pid_name, b"", 0o600, uid, gid)

args = [
    openvpn_bin,
    "--config", f"/proc/self/fd/{config_fd}",
    "--script-security", "1",
    "--writepid", pid_path,
    "--status", status_path, "5",
]

if auth_fd is not None:
    secure_replace(runtime_fd, auth_name, read_fd(auth_fd), 0o600, 0, 0)
    os.close(auth_fd)
    # Credential invariant:
    #
    # Keep VPN credentials out of argv. The QML process sends credentials to the
    # unprivileged shell helper over stdin, the helper stores them mode 0600, and
    # this privileged launcher copies them into a root-owned mode 0600 runtime
    # file for OpenVPN. --auth-nocache asks OpenVPN to discard credentials after
    # use rather than keeping them in process memory longer than needed.
    args.extend(["--auth-user-pass", auth_path, "--auth-nocache"])
else:
    try:
        os.unlink(auth_name, dir_fd=runtime_fd)
    except FileNotFoundError:
        pass

log_flags = os.O_WRONLY | os.O_APPEND
if hasattr(os, "O_NOFOLLOW"):
    log_flags |= os.O_NOFOLLOW
log_fd = os.open(log_name, log_flags, dir_fd=runtime_fd)
log_st = os.fstat(log_fd)
if not stat.S_ISREG(log_st.st_mode) or log_st.st_uid != uid or stat.S_IMODE(log_st.st_mode) != 0o600:
    os.close(log_fd)
    fail(f"unsafe log file: {log_path}")
try:
    openvpn_proc = subprocess.Popen(
        args,
        cwd="/",
        env={
            "HOME": "/",
            "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        },
        pass_fds=(config_fd,),
        stdout=log_fd,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
finally:
    os.close(log_fd)
    os.close(config_fd)

spawn_guard(
    runtime_fd,
    openvpn_proc.pid,
    nft,
    log_path,
    stop_path,
    killswitch_path,
    auth_path,
    guard_pid_path,
